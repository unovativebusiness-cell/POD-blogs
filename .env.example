# Public URL of THIS blog app (canonical URLs / sitemap)
SITE=https://writing.photographerondemand.in

# Where `/` redirects. Defaults to SITE if omitted.
HOME_URL=https://podbharat.photographerondemand.in

# Strapi CMS
STRAPI_URL=https://strapi.unovative.com

# POD marketing API (header features + footer)
POD_API_URL=https://api.photographerondemand.in/

# How long the Node process keeps Strapi articles in memory (ms). 60000 = 1 minute.
STRAPI_CACHE_TTL_MS=60000

# Bound by Plesk; usually set automatically
# HOST=127.0.0.1
# PORT=3000
