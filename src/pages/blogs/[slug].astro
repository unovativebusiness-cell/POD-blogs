---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getArticles } from '../../lib/strapi';
import { formatDate } from '../../lib/format';
import { renderMarkdown } from '../../lib/markdown';

const slug = Astro.params.slug;
if (!slug) {
  return Astro.redirect('/blogs');
}

const article = (await getArticles()).find((item) => item.slug === slug);
if (!article) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const site = Astro.site ?? new URL('https://writing.photographerondemand.in');
const canonical = new URL(`/blogs/${article.slug}`, site).href;
const description = article.description || article.title;
const title = `POD: ${article.title}`;
const blogsUrl = new URL('/blogs', site).href;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: article.title,
    description,
    datePublished: article.publishedAt,
    dateModified: article.updatedAt,
    mainEntityOfPage: canonical,
    image: article.cover ? [article.cover] : undefined,
    author: article.authorName
      ? { '@type': 'Person', name: article.authorName }
      : { '@type': 'Organization', name: 'POD', url: 'https://photographerondemand.in/' },
    publisher: {
      '@type': 'Organization',
      name: 'POD',
      url: 'https://photographerondemand.in/',
      logo: {
        '@type': 'ImageObject',
        url: new URL('/icons/logo.png', site).href,
      },
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'POD', item: 'https://photographerondemand.in/' },
      { '@type': 'ListItem', position: 2, name: 'Blogs', item: blogsUrl },
      { '@type': 'ListItem', position: 3, name: article.title, item: canonical },
    ],
  },
];

Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=300');
---

<BaseLayout
  title={title}
  description={description}
  image={article.cover}
  canonical={canonical}
  ogType="article"
  jsonLd={jsonLd}
>
  <div class="article-page">
    <a class="back-link" href="/blogs">← Back to Blogs</a>
    <article>
      {
        article.cover && (
          <div class="cover">
            <img src={article.cover} alt={article.imageAlt} />
          </div>
        )
      }
      <header>
        <div class="meta-row">
          <span class="category-pill">{article.category}</span>
          <time class="date" datetime={article.publishedAt}>{formatDate(article.publishedAt)}</time>
        </div>
        <h1>{article.title}</h1>
        {article.description && <p class="lede">{article.description}</p>}
        {
          article.authorName && (
            <div class="author-card">
              <span>{article.authorName}</span>
              {article.authorEmail && <span>{article.authorEmail}</span>}
            </div>
          )
        }
      </header>
      <div class="article-body">
        {article.blocks.length === 0 && <p>No content available.</p>}
        {
          article.blocks.map((block) => {
            if (block.type === 'rich-text') {
              return <div class="rich-text" set:html={renderMarkdown(block.body)} />;
            }
            if (block.type === 'quote') {
              return (
                <blockquote class="quote">
                  <p>{block.body}</p>
                  {block.title && <cite>— {block.title}</cite>}
                </blockquote>
              );
            }
            if (block.type === 'media' && block.file) {
              return (
                <figure class="media-block">
                  <img
                    src={block.file.url}
                    alt={block.file.alt}
                    width={block.file.width ?? undefined}
                    height={block.file.height ?? undefined}
                  />
                  {block.file.caption && <figcaption>{block.file.caption}</figcaption>}
                </figure>
              );
            }
            if (block.type === 'slider' && block.files.length > 0) {
              return (
                <div class="slider">
                  {block.files.map((file) => (
                    <img
                      src={file.url}
                      alt={file.alt}
                      width={file.width ?? undefined}
                      height={file.height ?? undefined}
                    />
                  ))}
                </div>
              );
            }
            return null;
          })
        }
      </div>
      <footer class="timestamps">
        <p>
          <strong>Published:</strong>{' '}
          <time datetime={article.publishedAt}>{formatDate(article.publishedAt)}</time>
        </p>
        <p>
          <strong>Last Updated:</strong>{' '}
          <time datetime={article.updatedAt}>{formatDate(article.updatedAt)}</time>
        </p>
      </footer>
    </article>
  </div>
</BaseLayout>
