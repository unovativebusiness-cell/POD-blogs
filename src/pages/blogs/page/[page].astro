---
import BlogListing from '../../../components/BlogListing.astro';
import { getArticles, pageCount } from '../../../lib/strapi';

const page = Number(Astro.params.page);
const totalPages = pageCount((await getArticles()).length);

if (!Number.isFinite(page) || page < 2) {
  return Astro.redirect('/blogs');
}

if (page > totalPages) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=300');
---

<BlogListing page={page} />
