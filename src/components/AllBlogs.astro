---
import { PAGE_SIZE, type Article, type CategoryOption } from '../lib/strapi';
import { formatDate } from '../lib/format';
import { paginationRange } from '../lib/pagination';
import BlogCard from './BlogCard.astro';

interface Props {
  blogs: Article[];
  allBlogs: Article[];
  categories: CategoryOption[];
  page: number;
  totalPages: number;
  total: number;
}

const { blogs, allBlogs, categories, page, totalPages, total } = Astro.props;

const hrefFor = (pageNumber: number) => (pageNumber <= 1 ? '/blogs' : `/blogs/page/${pageNumber}`);
const from = total === 0 ? 0 : (page - 1) * PAGE_SIZE + 1;
const to = (page - 1) * PAGE_SIZE + blogs.length;
const pages = paginationRange(page, totalPages);

const clientBlogs = allBlogs.map((blog) => ({
  slug: blog.slug,
  title: blog.title,
  description: blog.description,
  category: blog.category,
  categorySlug: blog.categorySlug,
  createdAt: blog.createdAt,
  dateLabel: formatDate(blog.createdAt),
  image: blog.image,
  imageSrcSet: blog.imageSrcSet,
  imageAlt: blog.imageAlt,
}));
const payload = JSON.stringify(clientBlogs).replace(/</g, '\\u003c');
---

<section class="all-blogs" data-all-blogs data-page-size={PAGE_SIZE} aria-labelledby="all-blogs-title">
  <script is:inline>
    if (location.search.includes('q=') || location.search.includes('category=') || location.search.includes('sort=asc') || /[?&]page=/.test(location.search)) {
      document.documentElement.classList.add('blogs-filtering');
    }
  </script>
  <div class="all-blogs-header">
    <div class="title-wrap">
      <span aria-hidden="true">⊞</span>
      <h2 id="all-blogs-title">All Blogs</h2>
    </div>
    <div class="controls">
      <input class="search-input" data-search type="search" placeholder="Search blogs" hidden />
      <button class="icon-btn" type="button" data-filter aria-expanded="false" aria-haspopup="true" title="Filter by category">≡</button>
      <button class="icon-btn" type="button" data-sort aria-pressed="false" title="Showing newest first">↕</button>
      <button class="icon-btn" type="button" data-search-toggle aria-pressed="false" title="Search blogs">🔍</button>
      <div class="category-menu" data-categories hidden>
        <button type="button" data-category="all" aria-pressed="true">All</button>
        {
          categories.map((category) => (
            <button type="button" data-category={category.slug} aria-pressed="false">
              {category.name}
            </button>
          ))
        }
      </div>
    </div>
  </div>

  <p class="blogs-status" data-status>
    {total === 0 ? 'No blogs yet' : `Showing ${from}–${to} of ${total}`}
  </p>

  <div class="blogs-grid" data-grid>
    {blogs.map((blog) => <BlogCard blog={blog} date={formatDate(blog.createdAt)} />)}
  </div>

  <nav class="pagination pagination-ssr" data-pagination-ssr aria-label="Blog pages">
    {
      page > 1 ? (
        <a class="page-link page-nav" href={hrefFor(page - 1)} rel="prev">
          Previous
        </a>
      ) : (
        <span class="page-link page-nav is-disabled" aria-disabled="true">Previous</span>
      )
    }
    {
      pages.map((token) =>
        token === 'ellipsis' ? (
          <span class="page-ellipsis" aria-hidden="true">
            …
          </span>
        ) : (
          <a
            class="page-link"
            href={hrefFor(token)}
            aria-current={token === page ? 'page' : undefined}
            aria-label={`Page ${token}`}
          >
            {token}
          </a>
        ),
      )
    }
    {
      page < totalPages ? (
        <a class="page-link page-nav" href={hrefFor(page + 1)} rel="next">
          Next
        </a>
      ) : (
        <span class="page-link page-nav is-disabled" aria-disabled="true">Next</span>
      )
    }
  </nav>
  <nav class="pagination pagination-client" data-pagination-client aria-label="Filtered blog pages" hidden></nav>
  <button class="clear-btn" type="button" data-clear hidden>Clear filters</button>
  <script id="all-blogs-data" type="application/json" set:html={payload} />
</section>

<script>
  const root = document.querySelector<HTMLElement>('[data-all-blogs]');
  const dataEl = document.getElementById('all-blogs-data');
  if (root && dataEl?.textContent) {
    const blogs = JSON.parse(dataEl.textContent) as {
      slug: string;
      title: string;
      description: string;
      categorySlug: string;
      createdAt: string;
      dateLabel: string;
      image: string;
      imageSrcSet: string;
      imageAlt: string;
    }[];
    const grid = root.querySelector<HTMLElement>('[data-grid]')!;
    const ssrPagination = root.querySelector<HTMLElement>('[data-pagination-ssr]')!;
    const clientPagination = root.querySelector<HTMLElement>('[data-pagination-client]')!;
    const status = root.querySelector<HTMLElement>('[data-status]')!;
    const search = root.querySelector<HTMLInputElement>('[data-search]')!;
    const categoryMenu = root.querySelector<HTMLElement>('[data-categories]')!;
    const sortButton = root.querySelector<HTMLButtonElement>('[data-sort]')!;
    const filterButton = root.querySelector<HTMLButtonElement>('[data-filter]')!;
    const searchButton = root.querySelector<HTMLButtonElement>('[data-search-toggle]')!;
    const clearButton = root.querySelector<HTMLButtonElement>('[data-clear]')!;
    const pageSize = Number(root.dataset.pageSize) || 9;

    type FilterState = { q: string; category: string; sort: 'asc' | 'desc'; page: number };

    const readState = (): FilterState => {
      const params = new URLSearchParams(location.search);
      return {
        q: params.get('q')?.trim() || '',
        category: params.get('category') || 'all',
        sort: params.get('sort') === 'asc' ? 'asc' : 'desc',
        page: Math.max(1, Number(params.get('page')) || 1),
      };
    };

    const isDefault = (state: FilterState) =>
      !state.q && state.category === 'all' && state.sort === 'desc' && !new URLSearchParams(location.search).has('page');

    const matching = (state: FilterState) => {
      const query = state.q.toLowerCase();
      return blogs
        .filter((blog) => {
          const categoryMatches = state.category === 'all' || blog.categorySlug === state.category;
          const haystack = `${blog.title} ${blog.description}`.toLowerCase();
          return categoryMatches && (!query || haystack.includes(query));
        })
        .sort((a, b) => {
          const delta = +new Date(a.createdAt) - +new Date(b.createdAt);
          return state.sort === 'asc' ? delta : -delta;
        });
    };

    const writeUrl = (state: FilterState, mode: 'push' | 'replace') => {
      const params = new URLSearchParams();
      if (state.q) params.set('q', state.q);
      if (state.category !== 'all') params.set('category', state.category);
      if (state.sort === 'asc') params.set('sort', 'asc');
      if (state.page > 1) params.set('page', String(state.page));
      const next = params.toString() ? `/blogs?${params}` : '/blogs';
      const historyMode = mode === 'push' ? 'pushState' : 'replaceState';
      history[historyMode](state, '', next);
    };

    const renderCard = (blog: (typeof blogs)[number]) => {
      const link = document.createElement('a');
      link.className = 'blog-card';
      link.href = `/blogs/${blog.slug}`;
      const imageWrap = document.createElement('div');
      imageWrap.className = 'image-wrap';
      const image = document.createElement('img');
      image.src = blog.image;
      if (blog.imageSrcSet) image.srcset = blog.imageSrcSet;
      image.sizes = '(max-width: 600px) 100vw, (max-width: 992px) 50vw, 33vw';
      image.alt = blog.imageAlt || blog.title;
      image.loading = 'lazy';
      imageWrap.append(image);
      const content = document.createElement('div');
      content.className = 'content';
      const title = document.createElement('h3');
      title.textContent = blog.title;
      const date = document.createElement('p');
      date.className = 'date';
      date.textContent = blog.dateLabel;
      const more = document.createElement('span');
      more.className = 'read-more';
      more.textContent = 'Read More';
      content.append(title, date, more);
      link.append(imageWrap, content);
      return link;
    };

    const render = (state: FilterState) => {
      const list = matching(state);
      const pages = Math.max(1, Math.ceil(list.length / pageSize));
      const current = Math.min(state.page, pages);
      const slice = list.slice((current - 1) * pageSize, current * pageSize);
      grid.replaceChildren(...slice.map(renderCard));
      root.querySelector('[data-empty]')?.remove();
      if (!slice.length) {
        const empty = document.createElement('p');
        empty.className = 'empty-state';
        empty.dataset.empty = 'true';
        empty.textContent = 'No blogs match your filters.';
        grid.after(empty);
      }
      const fromItem = list.length ? (current - 1) * pageSize + 1 : 0;
      const toItem = (current - 1) * pageSize + slice.length;
      status.textContent = list.length ? `Showing ${fromItem}–${toItem} of ${list.length}` : 'No matching blogs';
      ssrPagination.hidden = true;
      clientPagination.hidden = pages <= 1;
      clientPagination.replaceChildren();

      const pageWindow = (currentPage: number, totalPageCount: number) => {
        if (totalPageCount <= 1) return [1] as Array<number | 'ellipsis'>;
        const first = 1;
        const last = totalPageCount;
        const start = Math.max(first + 1, currentPage - 1);
        const end = Math.min(last - 1, currentPage + 1);
        const items: Array<number | 'ellipsis'> = [first];
        if (start > first + 1) items.push('ellipsis');
        for (let pageNumber = start; pageNumber <= end; pageNumber += 1) items.push(pageNumber);
        if (end < last - 1) items.push('ellipsis');
        if (last > first) items.push(last);
        return items;
      };

      const goTo = (pageNumber: number) => {
        const next = { ...readState(), page: pageNumber };
        writeUrl(next, 'push');
        render(next);
        root.scrollIntoView({ behavior: 'smooth', block: 'start' });
      };

      const appendNav = (label: string, pageNumber: number | null) => {
        if (pageNumber === null) {
          const disabled = document.createElement('span');
          disabled.className = 'page-link page-nav is-disabled';
          disabled.setAttribute('aria-disabled', 'true');
          disabled.textContent = label;
          clientPagination.append(disabled);
          return;
        }
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'page-link page-nav';
        button.textContent = label;
        button.addEventListener('click', () => goTo(pageNumber));
        clientPagination.append(button);
      };

      appendNav('Previous', current > 1 ? current - 1 : null);
      for (const token of pageWindow(current, pages)) {
        if (token === 'ellipsis') {
          const dots = document.createElement('span');
          dots.className = 'page-ellipsis';
          dots.setAttribute('aria-hidden', 'true');
          dots.textContent = '…';
          clientPagination.append(dots);
          continue;
        }
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'page-link';
        button.textContent = String(token);
        button.setAttribute('aria-label', `Page ${token}`);
        if (token === current) button.setAttribute('aria-current', 'page');
        button.addEventListener('click', () => goTo(token));
        clientPagination.append(button);
      }
      appendNav('Next', current < pages ? current + 1 : null);
      search.value = state.q;
      if (state.q) search.hidden = false;
      sortButton.setAttribute('aria-pressed', String(state.sort === 'asc'));
      sortButton.title = state.sort === 'asc' ? 'Showing oldest first' : 'Showing newest first';
      categoryMenu.querySelectorAll<HTMLButtonElement>('button').forEach((button) => {
        button.setAttribute('aria-pressed', String(button.dataset.category === state.category));
      });
      clearButton.hidden = false;
      document.documentElement.classList.remove('blogs-filtering');
    };

    const apply = (partial: Partial<FilterState>) => {
      const state = { ...readState(), page: 1, ...partial };
      writeUrl(state, 'replace');
      render(state);
    };

    filterButton.addEventListener('click', () => {
      const open = filterButton.getAttribute('aria-expanded') === 'true';
      filterButton.setAttribute('aria-expanded', String(!open));
      categoryMenu.hidden = open;
    });

    categoryMenu.querySelectorAll<HTMLButtonElement>('button').forEach((button) => {
      button.addEventListener('click', () => {
        apply({ category: button.dataset.category || 'all' });
        categoryMenu.hidden = true;
        filterButton.setAttribute('aria-expanded', 'false');
      });
    });

    sortButton.addEventListener('click', () => {
      apply({ sort: readState().sort === 'asc' ? 'desc' : 'asc' });
    });

    searchButton.addEventListener('click', () => {
      search.hidden = !search.hidden;
      searchButton.setAttribute('aria-pressed', String(!search.hidden));
      if (!search.hidden) search.focus();
    });

    search.addEventListener('input', () => apply({ q: search.value.trim() }));

    clearButton.addEventListener('click', () => {
      location.assign('/blogs');
    });

    window.addEventListener('popstate', () => {
      const state = readState();
      if (isDefault(state)) location.reload();
      else render(state);
    });

    const initial = readState();
    if (!isDefault(initial)) render(initial);
  }
</script>
