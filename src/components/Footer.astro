---
interface Props {
  blurb: string;
  officeLabel: string;
  officeValue: string;
}

const { blurb, officeLabel, officeValue } = Astro.props;
const year = new Date().getFullYear();
const blogsHome = (
  import.meta.env.HOME_URL ||
  process.env.HOME_URL ||
  'https://podbharat.photographerondemand.in/blogs'
).replace(/\/$/, '');

const company = [
  ['About', 'https://photographerondemand.in/aboutus'],
  ['Contact Us', 'https://photographerondemand.in/contactus'],
  ["FAQ's", 'https://photographerondemand.in/faq'],
];

const legal = [
  ['Terms & Conditions', 'https://photographerondemand.in/termsofservice'],
  ['Privacy policy', 'https://photographerondemand.in/privacypolicy'],
  ['Refund policy', 'https://photographerondemand.in/refundpolicy'],
];
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="subscribe">
      <h2>Stay Updated With Us</h2>
      <p>Subscribe the blogs, to know about photography</p>
      <form id="subscribe-form">
        <label class="sr-only" for="subscribe-email">Email</label>
        <input id="subscribe-email" name="email" type="email" placeholder="Email" required />
        <button type="submit">Notify Me</button>
        <p class="form-status" role="status"></p>
      </form>
    </div>

    <div class="footer-grid">
      <div>
        <a class="footer-brand" href={blogsHome} aria-label="POD home">
          <img src="/icons/mark.png" alt="" width="46" height="46" />
          <img src="/icons/wordmark.png" alt="POD" width="74" height="26" />
        </a>
        <p class="footer-blurb">{blurb}</p>
        <div class="office">
          <strong>{officeLabel}</strong>
          <p>{officeValue}</p>
        </div>
      </div>

      <div class="footer-links">
        <div class="footer-col">
          <h2>Menu</h2>
          <a href="https://photographerondemand.in/gallery" target="_blank" rel="noopener noreferrer">Gallery</a>
          <a href="https://photographerondemand.in/podian" target="_blank" rel="noopener noreferrer">Join PODIANS</a>
          <a href={blogsHome}>Blogs</a>
        </div>
        <div class="footer-col">
          <h2>Company</h2>
          {
            company.map(([label, href]) => (
              <a href={href} target="_blank" rel="noopener noreferrer">
                {label}
              </a>
            ))
          }
          <details class="legal">
            <summary>Legal</summary>
            <div class="legal-menu">
              {
                legal.map(([label, href]) => (
                  <a href={href} target="_blank" rel="noopener noreferrer">
                    {label}
                  </a>
                ))
              }
            </div>
          </details>
        </div>
        <div class="footer-col">
          <h2>Follow on</h2>
          <div class="socials">
            <a href="https://www.facebook.com/podphotographerondemand/" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
              <img src="/icons/facebook.png" alt="" />
            </a>
            <a href="https://www.instagram.com/podbharat/" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
              <img src="/icons/instagram.png" alt="" />
            </a>
            <a href="https://www.linkedin.com/company/podian/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
              <img src="/icons/linkedin.png" alt="" />
            </a>
            <a href="https://www.youtube.com/@podphotographerondemand9334" target="_blank" rel="noopener noreferrer" aria-label="YouTube">
              <img src="/icons/youtube.png" alt="" />
            </a>
          </div>
          <h2>Download On</h2>
          <div class="stores">
            <a href="https://play.google.com/store/apps/details?id=com.seawindsolution.pod" target="_blank" rel="noopener noreferrer">
              <img src="/icons/playstore.png" alt="Get it on Google Play" />
            </a>
            <a href="https://apps.apple.com/in/app/photographer-on-demand/id1503321883" target="_blank" rel="noopener noreferrer">
              <img src="/icons/appstore.png" alt="Download on the App Store" />
            </a>
          </div>
        </div>
      </div>
    </div>
    <p class="copyright">Copyright @{year} by Podian Pvt Ltd.</p>
  </div>
</footer>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    border: 0;
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('#subscribe-form');
  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const status = form.querySelector<HTMLElement>('.form-status');
    const email = new FormData(form).get('email')?.toString().trim() ?? '';
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      if (status) status.textContent = 'Invalid email address.';
      return;
    }
    const body = new FormData();
    body.append('email', email);
    try {
      const response = await fetch('https://api.photographerondemand.in/landing/web/subscribeBlogs', {
        method: 'POST',
        body,
      });
      const result = (await response.json()) as { s?: number; m?: string };
      if (status) status.textContent = result.s ? 'Successfully subscribed.' : result.m || 'Could not subscribe.';
      if (result.s) form.reset();
    } catch {
      if (status) status.textContent = 'Could not subscribe right now.';
    }
  });
</script>
